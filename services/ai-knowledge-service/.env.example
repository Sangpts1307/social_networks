# Local trực tiếp; chỉnh theo dịch vụ trên máy. Không ghi secret thật vào template.
APP_ENV=local
AI_KNOWLEDGE_PORT=8090
DATABASE_URL=mysql+pymysql://app:CHANGE_ME@127.0.0.1:3306/ai_knowledge_db
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME

AI_GATEWAY_KEY=
LEARNING_GATEWAY_KEY=
LEARNING_SERVICE_URL=http://127.0.0.1:8083
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
AI_API_BASE_URL=https://api.openai.com/v1
AI_EXTERNAL_PROCESSING_ENABLED=true
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=2048
