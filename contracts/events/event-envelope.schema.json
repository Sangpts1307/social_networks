{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal-social-network.local/contracts/events/event-envelope.schema.json",
  "title": "Internal Social Network Event Envelope",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "occurred_at", "source_service", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+\\.v[0-9]+$" },
    "event_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source_service": { "type": "string", "enum": ["identity", "social", "learning", "chat", "notification", "ai-knowledge"] },
    "correlation_id": { "type": "string", "format": "uuid" },
    "causation_id": { "type": "string", "format": "uuid" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
